# CareWatch AI Environment Configuration
# Copy this file to .env.local for local development

# Supabase Public Configuration (Exposed to browser via NEXT_PUBLIC)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Secret (Never exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API Key (Server-Only Secret - Never exposed to client)
GEMINI_API_KEY=your-gemini-api-key

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

